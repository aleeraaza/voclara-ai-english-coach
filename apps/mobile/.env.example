# Copy to .env.local (git-ignored). EXPO_PUBLIC_* values are bundled into the
# app, so never put secrets here.

# Android emulator -> your PC's localhost:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Real phone on the same Wi-Fi: use your PC's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
