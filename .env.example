# --- Core (used now) ---
APP_ENV=development          # development | production
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://voclara:voclara@localhost:5433/voclara
DB_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true
LOG_FORMAT=pretty            # pretty | json
RUST_LOG=voclara_api=debug,tower_http=info,sqlx=warn

# --- Auth ---
# At least 32 bytes. Production refuses any value starting with "dev-only".
# Generate one with:  openssl rand -base64 48
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789
ACCESS_TTL_SECS=900          # 15 minutes
REFRESH_TTL_DAYS=30
OTP_PROVIDER=log             # log = print codes to the server log (dev only)
GOOGLE_CLIENT_IDS=           # comma-separated OAuth client ids (Android, web)

# --- Used in later steps (leave blank for now) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
VOICE_PROVIDER=gemini        # gemini | openai
VOICE_MODEL=                 # from provider docs, never hard-coded
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GRADER_MODEL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
OTP_PROVIDER_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
REVENUECAT_WEBHOOK_SECRET=
SAFEPAY_SECRET=
PADDLE_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
